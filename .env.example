# Copie para .env e preencha com valores reais -- .env nunca é commitado.

# Connection string do Postgres (Supabase, Neon, ou local).
# No Supabase: Project Settings > Database > Connect > Connection string (URI),
# modo "Session" (porta 5432) -- o ingest usa COPY, que precisa de conexão direta.
OLIST_PG_DSN=postgresql://usuario:senha@host:5432/postgres

# MongoDB usado para os dados "não-estruturados" (reviews + tickets de suporte
# sintéticos). Padrão: instância local.
OLIST_MONGO_URI=mongodb://127.0.0.1:27017
OLIST_MONGO_DB=olist

# Role restrita a SELECT no schema `raw` -- usada pelo run_sql do servidor
# MCP (ver sql/rag_reader_role.sql). Mesma connection string de OLIST_PG_DSN,
# trocando usuário/senha pelos da role rag_reader.
OLIST_PG_READER_DSN=postgresql://rag_reader:senha@host:5432/postgres

# Agente LangChain (ChatAnthropic).
ANTHROPIC_API_KEY=sk-ant-...

# Protege o chat web em produção (HTTP Basic Auth) -- sem isso, qualquer
# pessoa com o link gera custo na sua chave da Anthropic. Vazio = sem
# proteção (ok em desenvolvimento local).
SITE_PASSWORD=
